# 商场聚类项目 · 外部服务密钥模板
#
# 用法：复制本文件为同目录下的 .env，填入实际值。
# .env 已在 .gitignore 中，不会被提交。
#
# 高德地图 Web 服务应用（用于抓取商场区位、行政区、商圈、经纬度）
# 未开启数字签名时只填 KEY；开启数字签名后同时填该 Key 对应的私钥。
# 申请入口：https://console.amap.com/dev/key/app
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_PRIVATE_KEY=

# 百度地图服务端应用（备用地理编码来源，SN 校验）
BAIDU_MAP_AK=
BAIDU_MAP_SK=
